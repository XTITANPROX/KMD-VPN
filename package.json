{
  "name": "kalfetela",
  "version": "1.0.0",
  "description": "KALFETELA — a Persian-first, multi-user Cloudflare Workers tunnel panel with VLESS, Trojan, VMess, Fragment, DoH and Iran-aware routing.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "tailconfig": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply kalfetela --local",
    "db:migrate:remote": "wrangler d1 migrations apply kalfetela --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-or-later"
}
